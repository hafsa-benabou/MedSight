# --- Base de données ---
DATABASE_URL=postgresql+psycopg://medisight:medisight@localhost:5432/medisight
POSTGRES_USER=medisight
POSTGRES_PASSWORD=medisight   # identique à DATABASE_URL ; à changer en production (les deux)
POSTGRES_DB=medisight
# --- API ---
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_ENABLED=true
MAX_UPLOAD_MB=8
STORE_UPLOADED_IMAGES=false
CONVERSATION_RETENTION_HOURS=72
IDENTIFICATION_RETENTION_HOURS=24
# --- LLM (optionnel ; désactivé par défaut, consentement utilisateur requis) ---
LLM_PROVIDER=none            # none | anthropic | openai
LLM_MODEL=                   # ex. claude-haiku-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# --- MedBase (optionnel, clé sur demande) ---
MEDBASE_API_KEY=
# --- OCR ---
OCR_ENGINE=tesseract
TESSERACT_LANGS=fra+eng
# --- Sécurité (à revérifier avant production) ---
EMERGENCY_SAMU=141
EMERGENCY_CIVIL_PROTECTION=15
POISON_CENTER=0801 000 180
